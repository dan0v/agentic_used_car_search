root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# JSON in this repo is a mix of 2- and 4-space (package.json vs server.json),
# and reformatting it is not worth the churn. The checks that catch real
# problems - line endings, final newline, trailing whitespace - still apply.
[*.{json,jsonc}]
indent_size = unset

[*.{yml,yaml}]
indent_size = 2

[*.md]
# Markdown nests lists at 2 spaces and uses trailing double-space for hard
# line breaks; neither is an error.
indent_size = unset
trim_trailing_whitespace = false
